// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Episode {
  id       String @id @default(uuid())
  title    String
  error    String
  solution String

  stackId String @map("stack_id")
  stack   Stack  @relation(fields: [stackId], references: [id], onDelete: Cascade)

  annotations Annotation[]

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  episodeReviews     EpisodeReview[]
  focusSessionItems  FocusSessionItem[]

  @@map("episodes")
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  hashedRefreshToken String?  @map("hashed_refresh_token")
  avatarUrl          String?
  role               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stacks Stack[]

  @@map("users")
}

model Stack {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  episodes      Episode[]
  focusSessions FocusSession[]

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stacks")
}

model Annotation {
  id        String    @id @default(uuid())
  text      String
  episodeId String    @map("episode_id")
  episode   Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("annotations")
}

model EpisodeReview {
  id             String        @id @default(uuid())
  episodeId      String        @map("episode_id")
  episode        Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  reviewAt       DateTime      @default(now()) @map("review_at")
  result         String
  focusSessionId String?       @map("focus_session_id")
  focusSession   FocusSession? @relation(fields: [focusSessionId], references: [id], onDelete: SetNull)

  @@map("episode_reviews")
}

model FocusSession {
  id           String    @id @default(uuid())
  stackId      String    @map("stack_id")
  stack        Stack     @relation(fields: [stackId], references: [id], onDelete: Cascade)
  status       String    @default("in_progress")
  currentIndex Int       @default(0) @map("current_index")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  items          FocusSessionItem[]
  episodeReviews EpisodeReview[]

  @@map("focus_sessions")
}

model FocusSessionItem {
  id             String    @id @default(uuid())
  focusSessionId String    @map("focus_session_id")
  focusSession   FocusSession @relation(fields: [focusSessionId], references: [id], onDelete: Cascade)
  episodeId      String    @map("episode_id")
  episode        Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  position       Int
  status         String    @default("pending")
  answeredAt     DateTime? @map("answered_at")

  @@unique([focusSessionId, episodeId])
  @@map("focus_session_items")
}
